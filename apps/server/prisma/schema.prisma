// The full schema is modelled up front, including tables whose features are
// phases away. Retrofitting Gmail ID storage or session-by-user lookup onto a
// live table is a data migration; adding them to the initial migration is free.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — the state machine belongs in the schema.
// Mirrored in packages/shared/src/domain.ts, asserted equal at compile time by
// apps/server/src/domain/enums.ts.
// ---------------------------------------------------------------------------

enum Role {
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL_QUESTION
  REFUND_REQUEST
  GENERAL_QUESTION
}

enum WaitingOn {
  US
  CUSTOMER
}

enum ClassificationState {
  PENDING
  DONE
  FAILED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DraftState {
  PENDING
  READY
  WITHHELD_NO_GROUNDING
  FAILED
}

enum JobType {
  CLASSIFY_TICKET
  SUMMARIZE_TICKET
  DRAFT_REPLY
  SEND_EMAIL
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

enum ActorType {
  USER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Users, sessions, and credential tokens
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(uuid())
  /// Always stored lowercased; the application normalizes before writing.
  email String @unique
  name  String
  role  Role   @default(AGENT)

  /// Null until the user redeems an invite and sets a password. Never selected
  /// by default — every read uses an explicit `select`.
  passwordHash String?
  /// Set by the bootstrap seed and by admin-initiated resets.
  mustChangePassword Boolean @default(false)

  /// Departed users are deactivated, never deleted: their name stays attached
  /// to every reply they sent, for audit integrity.
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  lastLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  invitesReceived     InviteToken[]  @relation("InviteRecipient")
  invitesCreated      InviteToken[]  @relation("InviteCreator")
  resetTokens         ResetToken[]
  assignedTickets     Ticket[]       @relation("TicketAssignee")
  correctedTickets    Ticket[]       @relation("TicketCategoryCorrector")
  messagesSent        Message[]      @relation("MessageAuthor")
  auditEvents         AuditEvent[]
  kbDocumentsCreated  KbDocument[]   @relation("KbDocumentCreator")
  kbDocumentsUpdated  KbDocument[]   @relation("KbDocumentUpdater")

  @@index([isActive])
  @@map("users")
}

/// Backs `connect-pg-simple`, which owns `sid` / `sess` / `expire`. `userId` is
/// an explicit indexed column the application stamps at login so that sessions
/// are queryable — and therefore revocable — by user. Deactivation that cannot
/// revoke a live cookie is cosmetic.
model Session {
  sid    String   @id
  sess   Json
  expire DateTime @db.Timestamp(6)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expire])
  @@map("session")
}

/// Invite and reset tokens are stored hashed: a token in a stolen database dump
/// is otherwise a live credential.
model InviteToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation("InviteRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("invite_tokens")
}

model ResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("reset_tokens")
}

// ---------------------------------------------------------------------------
// Customers and tickets
// ---------------------------------------------------------------------------

/// A customer is identified by email address. No login, no portal, no password.
model Customer {
  id          String   @id @default(uuid())
  email       String   @unique
  /// From mail headers when present.
  displayName String?
  firstSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@map("customers")
}

model Ticket {
  id String @id @default(uuid())
  /// Short human-facing reference used in the UI and in conversation.
  number Int @unique @default(autoincrement())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  subject String

  status              TicketStatus        @default(OPEN)
  waitingOn           WaitingOn           @default(US)
  classificationState ClassificationState @default(PENDING)

  /// Current category — the classifier's value unless an agent corrected it.
  category TicketCategory?

  /// What the classifier said, kept separate from `category` so that agent
  /// corrections remain measurable as labeled eval data.
  aiCategory           TicketCategory?
  aiCategoryConfidence Float?
  categoryCorrectedAt  DateTime?
  categoryCorrectedById String?
  categoryCorrectedBy   User?    @relation("TicketCategoryCorrector", fields: [categoryCorrectedById], references: [id], onDelete: SetNull)

  /// Optional. Claiming signals "I'm on this" and never restricts anyone else.
  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Set when the grounding gate withholds a draft: this ticket needs manual
  /// research, and the rate of these measures knowledge base coverage.
  flaggedForResearch Boolean @default(false)

  summary            String?
  summaryGeneratedAt DateTime?

  /// Gmail thread this ticket tracks. Deliberately NOT unique: a reply to a
  /// closed ticket opens a new ticket on the same thread, cross-linked below.
  /// Reply mapping resolves to the most recent non-closed ticket for the thread.
  gmailThreadId String?

  /// Cross-link for the closed → new ticket path, so history stays traversable.
  previousTicketId String? @unique
  previousTicket   Ticket? @relation("TicketContinuation", fields: [previousTicketId], references: [id], onDelete: SetNull)
  nextTicket       Ticket? @relation("TicketContinuation")

  /// Metric timestamps. `firstResponseAt` counts only human outbound messages;
  /// a ticket that auto-resolves without a reply has no first-response time.
  firstInboundAt      DateTime?
  firstResponseAt     DateTime?
  lastInboundAt       DateTime?
  lastOutboundAt      DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  reopenCount         Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    Message[]
  drafts      Draft[]
  auditEvents AuditEvent[]
  jobs        Job[]

  /// The default queue view: status = OPEN AND waitingOn = US, oldest first.
  @@index([status, waitingOn, createdAt])
  @@index([status, category, createdAt])
  @@index([assigneeId, status])
  @@index([customerId, createdAt])
  @@index([gmailThreadId])
  /// Drives the auto-resolve (7d) and auto-close (14d) sweeps.
  @@index([status, waitingOn, lastOutboundAt])
  @@index([status, resolvedAt])
  @@map("tickets")
}

model Message {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  direction MessageDirection

  /// Set for outbound only. Every outbound message is sent by a named human —
  /// a CHECK constraint in the initial migration enforces that, and the FK
  /// restricts deletes so a user row can never be removed out from under the
  /// replies they sent. Departed users are deactivated, never deleted.
  authorId String?
  author   User?   @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  subject  String?
  bodyText String
  bodyHtml String?

  /// AI adoption flags — the durable record the dashboard queries. Acceptance
  /// rate cannot be reconstructed after the fact, so these ship with the first
  /// draft feature rather than later.
  ///
  /// Deliberately no default: every call site must state whether the message
  /// began as a draft. A default would let a send path that forgets compile,
  /// run, and record a false negative against the primary success metric.
  /// A CHECK constraint pairs the two fields so they cannot disagree.
  aiDrafted        Boolean
  /// Null when `aiDrafted` is false; otherwise whether the agent materially
  /// edited the draft before sending.
  aiDraftEdited    Boolean?
  sourceDraftId    String?
  sourceDraft      Draft?   @relation(fields: [sourceDraftId], references: [id], onDelete: SetNull)

  /// Idempotency key for inbound polling: an overlapping poll or a retry must
  /// not create the same message twice.
  gmailMessageId String? @unique
  gmailThreadId  String?

  /// When the mail was sent or received, as distinct from when the row was written.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  attachments Attachment[]

  @@index([ticketId, occurredAt])
  @@index([authorId, occurredAt])
  @@index([direction, occurredAt])
  @@map("messages")
}

/// Inbound only in v1. Files live in object storage, never in the database.
model Attachment {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  sizeBytes   Int
  /// Opaque key for the storage abstraction (filesystem locally, S3 deployed).
  storageKey  String  @unique
  checksum    String?

  gmailAttachmentId String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// AI drafts and the knowledge base
// ---------------------------------------------------------------------------

/// One row per generation attempt, including withheld ones — withholding is a
/// knowledge base coverage measurement, not a failure to hide.
model Draft {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  state DraftState @default(PENDING)
  body  String?

  /// Set when `state = WITHHELD_NO_GROUNDING` or `FAILED`.
  withheldReason String?

  /// Call metadata, so cost and latency stay attributable per draft.
  model            String?
  effort           String?
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  latencyMs        Int?

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  citations DraftCitation[]
  messages  Message[]

  @@index([ticketId, generatedAt])
  @@index([state, generatedAt])
  @@map("drafts")
}

/// A draft's factual claims must trace to at least one knowledge base document,
/// and the agent must be able to verify without leaving the ticket.
model DraftCitation {
  id      String @id @default(uuid())
  draftId String
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  kbDocumentId String
  kbDocument   KbDocument @relation(fields: [kbDocumentId], references: [id], onDelete: Cascade)

  /// The passage the model drew on, for inline verification.
  quote String?

  createdAt DateTime @default(now())

  @@unique([draftId, kbDocumentId])
  @@index([kbDocumentId])
  @@map("draft_citations")
}

/// The sole factual source for AI-drafted replies. Admins author; agents read.
model KbDocument {
  id    String @id @default(uuid())
  slug  String @unique
  title String
  /// Markdown.
  body  String

  /// Archived documents stop feeding drafts but stay linked from past citations.
  archivedAt DateTime?

  createdById String?
  createdBy   User?   @relation("KbDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("KbDocumentUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  citations DraftCitation[]

  @@index([archivedAt])
  @@map("kb_documents")
}

// ---------------------------------------------------------------------------
// Jobs, audit, and mailbox state
// ---------------------------------------------------------------------------

/// A plain job table drained by the single worker with FOR UPDATE SKIP LOCKED.
/// Jobs are best-effort with a retry count: if one is lost, the ticket is still
/// visible and workable without its AI draft.
model Job {
  id      String    @id @default(uuid())
  type    JobType
  status  JobStatus @default(PENDING)
  payload Json      @default("{}")

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Optional idempotency key — prevents queueing the same work twice.
  dedupeKey String? @unique

  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  runAt       DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The claim query: pending work that is due, oldest first.
  @@index([status, runAt])
  @@index([ticketId])
  @@map("jobs")
}

/// Append-only. There are no update or delete paths in application code.
model AuditEvent {
  id String @id @default(uuid())

  actorType ActorType @default(USER)
  /// Null only when `actorType = SYSTEM`. Restricted rather than nulled on
  /// delete: an audit trail that forgets who acted is not an audit trail.
  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// e.g. `ticket.resolved`, `user.deactivated`, `ticket.category_corrected`.
  action     String
  entityType String
  entityId   String

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

/// Login attempts, for the per-account *and* per-IP rate limiting at 2.8.
///
/// This has to be shared state: the `api` service runs two or more Fargate
/// tasks, so an in-process limiter gives an attacker one bucket per task and
/// resets every counter on each rolling deploy — while looking perfectly
/// correct in a single-task dev environment. Redis is explicitly rejected by
/// the stack, so the attempts live in the same Postgres.
///
/// Backoff is preferred to lockout: a lockout policy hands an attacker a
/// denial-of-service against the whole support team.
model LoginAttempt {
  id String @id @default(uuid())

  /// Lowercased email as submitted. Not a foreign key — attempts against
  /// addresses that do not exist are exactly what needs limiting, and storing
  /// them as a relation would leak account existence.
  emailKey String
  ipKey    String

  succeeded Boolean

  occurredAt DateTime @default(now())

  @@index([emailKey, occurredAt])
  @@index([ipKey, occurredAt])
  /// Sweeping old attempts; retention is governed by the P.5 policy.
  @@index([occurredAt])
  @@map("login_attempts")
}

/// Single-row table holding Gmail polling state. `historyId` expires after
/// roughly a week of inactivity; the poller handles the 404 with a bounded full
/// resync rather than crashing.
model MailboxState {
  id String @id @default("default")

  historyId       String?
  lastPolledAt    DateTime?
  /// Feeds the dead-man's switch: no inbound email polled in N hours.
  lastInboundAt   DateTime?
  lastResyncAt    DateTime?
  lastPollError   String?

  updatedAt DateTime @updatedAt

  @@map("mailbox_state")
}
