# Copy to apps/server/.env. Loaded by the dev server, the Prisma CLI, and Vitest.
# In production these come from Secrets Manager as ECS task secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Swagger UI at /api/docs and the raw spec at /api/openapi.json.
# Unset means on everywhere except production. Setting it explicitly wins in
# both directions — an interactive console over customer data should never be
# exposed by accident.
# ENABLE_API_DOCS=true

# How many proxy hops to trust for req.ip. No proxy in front of the API
# locally, so 0. The deployed topology is CloudFront -> ALB -> api, so
# production sets 2. This number is what the Phase 2 per-IP rate limiter
# depends on being right.
TRUST_PROXY_HOPS=0

# docker-compose and the Homebrew setup both expose this same URL.
# connection_limit is set explicitly rather than taking Prisma's default
# (num_cpus * 2 + 1), which varies by task size: Fargate tasks x pool size
# must stay under the RDS max_connections. Tuned against RDS at 8.13.
DATABASE_URL=postgres://support:support@localhost:5432/helpdesk?connection_limit=5&pool_timeout=10
# Tests truncate every table between files — never point this at the dev database.
TEST_DATABASE_URL=postgres://support:support@localhost:5432/helpdesk_test?connection_limit=5&pool_timeout=10

# Attachment storage. `filesystem` locally; `s3` is wired at 8.6.
# The driver is constructed at boot, so a misconfigured one fails the deploy
# rather than the first email that carries an attachment.
STORAGE_DRIVER=filesystem
STORAGE_LOCAL_ROOT=.storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1

# There is no self-service signup, so the first admin is seeded. Change the
# password before using this anywhere real; first login forces a reset anyway.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin
