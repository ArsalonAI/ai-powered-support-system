# Copy to apps/server/.env. Loaded by the dev server, the Prisma CLI, and Vitest.
# This file is the only place configuration comes from — there is no secret
# manager and no deployed environment.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Swagger UI at /api/docs and the raw spec at /api/openapi.json.
# Unset means on everywhere except production. Setting it explicitly wins in
# both directions — an interactive console over customer data should never be
# exposed by accident.
# ENABLE_API_DOCS=true

# How many proxy hops to trust for req.ip. Nothing sits in front of the API, so
# 0. Leave it there unless a reverse proxy is genuinely added: this number is
# what the per-IP login rate limiter depends on being right.
TRUST_PROXY_HOPS=0

# Signs the session cookie. Required, and deliberately left empty here: a
# placeholder long enough to pass validation would boot, and the instruction to
# replace it would read as already satisfied. Empty fails at startup instead,
# which is the only way this stays a decision someone actually made.
# Generate your own:  openssl rand -base64 48
# Changing it invalidates every live session, which is what you want after a leak.
SESSION_SECRET=

# Session lifetimes. The idle window is renewed on every request; the absolute
# one is stamped at login and no amount of activity extends it. The tech stack
# lists concrete values as an open item — these are defaults for a small team on
# one machine, not a decision anyone has signed off.
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_LIFETIME_HOURS=12

# Checks new passwords against HIBP's range API (k-anonymity: only the first
# five characters of the SHA-1 leave the machine). Set to `off` for an offline
# machine. It fails open either way, logging a warning — a network hiccup must
# not block a password reset during an incident.
PASSWORD_BREACH_CHECK=on

# A local Postgres 17. Create the role and both databases once with:
#   psql postgres -f apps/server/scripts/create-databases.sql
# connection_limit is set explicitly rather than taking Prisma's default
# (num_cpus * 2 + 1), which varies by machine — the api and worker processes
# each open a pool against the same server.
DATABASE_URL=postgres://support:support@localhost:5432/helpdesk?connection_limit=5&pool_timeout=10
# Tests truncate every table between files — never point this at the dev database.
TEST_DATABASE_URL=postgres://support:support@localhost:5432/helpdesk_test?connection_limit=5&pool_timeout=10

# Attachments on the local disk. The driver is constructed at boot, so a
# misconfigured root fails at startup rather than on the first email that
# carries an attachment.
STORAGE_DRIVER=filesystem
STORAGE_LOCAL_ROOT=.storage

# There is no self-service signup, so the first admin is seeded. Needed by
# `pnpm db:seed`, not by the API — leave them unset and only seeding complains.
#
# Pick a real password. From Phase 3 this is a live ADMIN login against a server
# that binds every interface, and the `mustChangePassword` flag set on the
# account is only a banner until task 4.7 builds somewhere to change it. Both
# the env schema and the seed reject the placeholder this file used to ship.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin
