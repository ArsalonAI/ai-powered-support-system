{
  "name": "@support/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env scripts/prepare-test-db.ts && vitest run",
    "test:watch": "tsx --env-file-if-exists=.env scripts/prepare-test-db.ts && vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:coverage": "tsx --env-file-if-exists=.env scripts/prepare-test-db.ts && vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "catalog:",
    "@support/shared": "workspace:*",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.0.1",
    "express-session": "^1.19.0",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "catalog:",
    "openapi3-ts": "^4.6.0",
    "prisma": "catalog:",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
